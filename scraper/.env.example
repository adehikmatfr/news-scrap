# Salin menjadi .env lalu isi nilainya:  cp .env.example .env
# Bun membaca file .env di folder kerja secara otomatis (tanpa dotenv).
# Nilai di sini menimpa config.json. Jangan commit file .env.

# Endpoint penerima artikel. {id} diganti dengan ID artikel (32 karakter hex).
# Contoh: https://api.example.com/articles  atau  https://api.example.com/articles/{id}
WEBHOOK_URL=http://localhost:8080/articles

# Metode HTTP: POST, PATCH, atau PUT
WEBHOOK_METHOD=POST

# Token rahasia, dikirim sebagai header "Authorization: Bearer <token>". Kosongkan jika tidak perlu.
WEBHOOK_TOKEN=

# Port endpoint status (/health, /status) pada mode server. Kosong = server.port di config.json (default 3000).
PORT=

# Opsional: path binary agent-browser jika tidak ditemukan otomatis di PATH.
# Linux:   /usr/local/bin/agent-browser
# Windows: C:/path/to/node_modules/agent-browser/bin/agent-browser-win32-x64.exe
#          Pakai garis miring "/": di dalam tanda kutip ganda, Bun membaca "\n" sebagai baris baru.
AGENT_BROWSER_BIN=

# Driver browser: agent-browser (default), playwright, atau cdp. Kosong = browserDriver di config.json.
# Perbandingan ketiganya: docs/adr/0003-driver-browser-agent-browser-playwright-atau-cdp.md
BROWSER_DRIVER=

# Path Chrome untuk driver playwright dan cdp. Wajib untuk cdp; kosong pada playwright = Chromium milik Playwright.
# Chrome milik agent-browser bisa dipakai, mis. C:/Users/<user>/.agent-browser/browsers/chrome-156.0.8078.80/chrome.exe
CHROME_PATH=

# 1 = nyalakan sandbox Chrome (driver playwright dan cdp). Kosong atau 0 = --no-sandbox.
CHROME_SANDBOX=
